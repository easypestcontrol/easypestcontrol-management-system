# Do not fill this in by hand and do not commit the result.
#
# Run `bash set-secrets.sh` on the VPS instead: it prompts, generates what can
# be generated, and writes .env at 0600. A secret that only ever exists between
# a keyboard and a file on one machine cannot leak from a chat window, a ticket
# or a screen share.

DB_PASSWORD=
JWT_SECRET=

# Cloudflare R2 — blank means photos stay in PostgreSQL.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

APP_DOMAIN=
API_DOMAIN=

# NOT here, on purpose:
#   Ola Maps key      → Settings → Integrations, in the running app
#   Razorpay keys     → Settings → Integrations, in the running app
# Both can then be rotated without a redeploy.
